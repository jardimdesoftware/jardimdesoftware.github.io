# URL base da API consumida pelo navegador (deve incluir o prefixo /api).
#
# O frontend e publicado como export estatico no GitHub Pages (sem
# servidor Node/SSR), entao esta e a UNICA variavel de ambiente que
# importa - toda busca de dados acontece no cliente, em build time
# (Next.js embute NEXT_PUBLIC_* no bundle no momento do `next build`).
#
# Em dev local (backend rodando com `npm run start:dev` na porta 3000,
# prefixo global "/api" - ver backend/src/presentation/main.ts):
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Em producao: aponte para onde o backend (NestJS + Postgres) estiver
# self-hosted. O host definitivo ainda nao foi decidido - o valor abaixo
# e um PLACEHOLDER; atualize a Repository Variable NEXT_PUBLIC_API_URL em
# Settings > Actions > Variables no GitHub assim que o backend tiver uma
# URL real (o workflow .github/workflows/deploy-pages.yml injeta essa
# variavel no build sem precisar mudar codigo).
# NEXT_PUBLIC_API_URL=https://api.jardimdesoftware.example.com/api
