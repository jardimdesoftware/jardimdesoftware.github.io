# =============================================================================
# backend/.env.example — Jardim de Software Backend
# =============================================================================
# Copie para backend/.env antes de rodar:
#   cp backend/.env.example backend/.env
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de Dados
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jardim?schema=public"

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_SECRET="dev-secret-key-nao-usar-em-producao"
JWT_EXPIRATION="24h"

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Swagger (OpenAPI) — defina como "false" para desabilitar.
SWAGGER_ENABLED=true

# CORS — origens permitidas (lista separada por vírgula, sem espaços).
# TODO: quando o frontend estiver publicado no GitHub Pages, adicione
# "https://jardimdesoftware.github.io" a esta lista (ele é servido na raiz
# do domínio — repo de user/org site, sem subpath).
CORS_ORIGINS="http://localhost:5500,http://127.0.0.1:5500"

# -----------------------------------------------------------------------------
# Seed (prisma/seed.ts)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@jardimdesoftware.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Administrador"

# -----------------------------------------------------------------------------
# Login com Google (painel admin)
# -----------------------------------------------------------------------------
# Crie um OAuth Client ID (tipo "Web application") no Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Em "Authorized redirect URIs" adicione exatamente o valor de GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# URL do frontend para onde o backend redireciona após o login com Google.
FRONTEND_URL="http://localhost:3002"
