    "typescript": "^5.1.3"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "jsonwebtoken": "^9.0.3",
    "qs": "^6.15.3",
    "multer": "^2.2.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
