# =============================================================================
# .env.example — Jardim de Software (docker-compose.yml: backend + Postgres + frontend dev)
# =============================================================================
# Copie para .env e preencha antes de rodar:
#   cp .env.example .env
# =============================================================================

# Banco de dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jardim

# Porta do backend exposta no host
BACKEND_PORT=4000

# Porta do frontend (dev, hot-reload) exposta no host
FRONTEND_PORT=3002

# JWT
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio-em-producao
JWT_EXPIRATION=24h

# Swagger (OpenAPI) em /api-docs
SWAGGER_ENABLED=true

# Origens permitidas no CORS. Inclui o frontend local (docker-compose) e o
# domínio do GitHub Pages (produção) por padrão — ajuste se mudar as portas.
CORS_ORIGINS=http://localhost:3002,https://jardimdesoftware.github.io

# Usadas só se você rodar o seed manualmente (não roda automático no start):
#   docker compose exec backend node dist/prisma/seed.js
SEED_ADMIN_EMAIL=admin@jardimdesoftware.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Administrador

# Login com Google no painel admin. Crie um OAuth Client ID (Web application)
# em https://console.cloud.google.com/apis/credentials e adicione o valor de
# GOOGLE_CALLBACK_URL nas "Authorized redirect URIs". Sem isso preenchido, o
# botão "Entrar com Google" simplesmente não funciona (login por senha
# continua funcionando normalmente).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# URL do frontend para onde o backend redireciona após o login com Google.
FRONTEND_URL=http://localhost:3002
